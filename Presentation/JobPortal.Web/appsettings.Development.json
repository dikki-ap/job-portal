{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "SpaProxyServerUrl": "http://localhost:5167",
  "SpaProxyLaunchCommand": "npm run dev",
  "ConnectionStrings": {
    "DefaultConnection": "Server=127.0.0.1;Port=3307;Database=JobPortal;User Id=job-portal-app;Password=job-portal@123!;CharSet=utf8mb4;"
  },
  "Keycloak": {
    "Authority": "http://localhost:9090/realms/job-portal",
    "ClientId": "job-portal-web",
    "Audience": "job-portal-web"
  },
  "Storage": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "job-portal-documents",
    "UseSSL": false,
    "ForcePathStyle": true,
    "PresignExpireMinutes": 15
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@jobportal.local",
    "FromName": "Job Portal"
  },
  "App": {
    "BaseUrl": "http://localhost:5167"
  }
}
